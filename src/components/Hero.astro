---
import { profile } from '../data/portfolioData';

const marqueeSkills = [
  'TypeScript',
  'React.js',
  'Astro Islands',
  'Tailwind CSS',
  'Next.js',
  'Node.js & Express',
  'PostgreSQL & MySQL',
  'RESTful API',
  'CS Fundamentals',
  'Git Workflow',
  'Antigravity IDE',
];

// Split words and characters for interactive kinetic letter-zoom
const headlineWords = [
  { text: 'Halo,', isGradient: false },
  { text: 'saya', isGradient: false },
  ...profile.fullName.split(' ').map((word) => ({ text: word, isGradient: true })),
];
---

<section id="about" class="relative pt-28 sm:pt-36 pb-16 sm:pb-20 overflow-hidden">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text & Intro Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Status Badge with Pulsing Radar Effect -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-medium mb-6 shadow-sm shadow-emerald-500/10">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="tracking-wide">Available for Internship — Semester 6</span>
        </div>

        <!-- Headline with Interactive Kinetic Letter-Zoom Effect -->
        <h1 id="hero-headline" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.2] py-1 select-none cursor-default flex flex-wrap gap-x-2.5 sm:gap-x-3.5 gap-y-1">
          {
            headlineWords.map((wordObj) => (
              <span class="inline-block whitespace-nowrap">
                {wordObj.text.split('').map((char) => (
                  <span
                    class={`hero-char inline-block transition-transform duration-100 ease-out origin-bottom ${
                      wordObj.isGradient ? 'gradient-text font-black' : 'text-white font-extrabold'
                    }`}
                  >
                    {char}
                  </span>
                ))}
              </span>
            ))
          }
        </h1>

        <!-- Subtitle with Dynamic Typewriter Rotating Roles -->
        <div class="mt-4 text-xl sm:text-2xl font-semibold text-slate-300 flex flex-wrap items-center gap-2">
          <span>Mahasiswa</span>
          <span class="text-indigo-400 font-bold">{profile.major}</span>
          <span>Semester {profile.semester}</span>
        </div>

        <!-- Dynamic Typing Role Banner -->
        <div class="mt-2 text-base sm:text-lg font-mono text-slate-300 flex items-center gap-2 bg-slate-900/60 border border-slate-800 px-3.5 py-1.5 rounded-xl">
          <span class="text-xs uppercase text-indigo-400 font-semibold tracking-wider">Role:</span>
          <span id="typewriter-role" class="text-slate-100 font-bold text-sm sm:text-base">Full-Stack Web Developer</span>
          <span class="w-2 h-4 bg-indigo-500 inline-block animate-pulse"></span>
        </div>

        <!-- University Tag - Sized larger than before but comfortably under the major/term headline -->
        <p class="mt-2 text-sm sm:text-base text-slate-300 font-medium flex items-center gap-2">
          <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span>di <strong class="text-white font-semibold">{profile.university}</strong></span>
        </p>

        <!-- Brief Description -->
        <p class="mt-5 text-base sm:text-lg text-slate-400 leading-relaxed max-w-2xl">
          {profile.bio}
        </p>

        <!-- CTAs with Dynamic Hover & Click Ripple -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#projects"
            class="btn-interactive inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 text-white hover:from-indigo-400 hover:to-purple-500 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-1 active:scale-95 transition-all duration-200"
          >
            <span>Lihat Proyek Unggulan</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="#contact"
            class="btn-interactive inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 hover:border-indigo-500/50 hover:-translate-y-1 active:scale-95 transition-all duration-200 shadow-md"
          >
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <span>Hubungi / Wawancara</span>
          </a>
        </div>

        <!-- Quick Links / Socials -->
        <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center gap-5">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Connect:</span>
          {
            profile.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-slate-300 hover:text-indigo-400 hover:underline transition-colors flex items-center gap-1.5"
              >
                <span>{social.platform}</span>
                <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Visual Tech Badge Card with Animated Border Beam & Floating Chips (5 cols) -->
      <div class="lg:col-span-5 flex justify-center relative">
        
        <!-- Floating Chip 1 (Top Left) -->
        <div class="hidden sm:flex absolute -top-5 -left-4 z-20 items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/90 border border-indigo-500/40 text-xs font-mono text-indigo-300 shadow-xl shadow-indigo-500/10 backdrop-blur-md animate-float-slow-1">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>⚡ Astro v7 Islands</span>
        </div>

        <!-- Floating Chip 2 (Bottom Right) -->
        <div class="hidden sm:flex absolute -bottom-5 -right-4 z-20 items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/90 border border-purple-500/40 text-xs font-mono text-purple-300 shadow-xl shadow-purple-500/10 backdrop-blur-md animate-float-slow-2">
          <span>⚛️ React 18 TSX</span>
        </div>

        <!-- Ambient Glow behind card -->
        <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 via-purple-600 to-pink-500 rounded-3xl blur-2xl opacity-25 group-hover:opacity-60 transition duration-700 pointer-events-none"></div>

        <!-- 3D Flip Card Container (Flips on cursor hover / tap to reveal photo & identity) -->
        <div id="internship-flip-card" class="flip-card-container group w-full max-w-md cursor-pointer select-none">
          <div class="flip-card-inner">
            
            <!-- FRONT SIDE: Internship Candidate Code Terminal -->
            <div class="flip-card-front border-beam-box rounded-2xl p-[1px] w-full shadow-2xl">
              <div class="border-beam-inner spotlight-card glass-card p-6 sm:p-7 rounded-2xl border border-slate-700/60 bg-slate-950/85 flex flex-col justify-between h-full">
                <!-- Header bar -->
                <div class="flex items-center justify-between pb-5 border-b border-slate-800">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  </div>
                  <span class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                    internship-candidate.ts
                  </span>
                  <span class="text-[10px] font-mono text-indigo-400/90 flex items-center gap-1 bg-indigo-500/10 px-2 py-0.5 rounded-full border border-indigo-500/25">
                    <span>↻ Hover / Tap</span>
                  </span>
                </div>

                <!-- Code/Profile Snippet -->
                <div class="pt-5 font-mono text-xs sm:text-sm space-y-2.5">
                  <p class="text-slate-400">// Snapshot Kualifikasi Kandidat</p>
                  <p><span class="text-purple-400">const</span> <span class="text-indigo-300">candidate</span> = &#123;</p>
                  <p class="pl-4"><span class="text-slate-400">name:</span> <span class="text-emerald-300">"{profile.fullName}"</span>,</p>
                  <p class="pl-4"><span class="text-slate-400">education:</span> <span class="text-amber-300">"D4 {profile.major}"</span>,</p>
                  <p class="pl-4"><span class="text-slate-400">currentTerm:</span> <span class="text-cyan-300">"Semester 5 (Active)"</span>,</p>
                  <p class="pl-4"><span class="text-slate-400">targetInternship:</span> <span class="text-emerald-300">"Semester 6 (2025/2026)"</span>,</p>
                  <p class="pl-4"><span class="text-slate-400">coreStack:</span> [</p>
                  <p class="pl-8 text-indigo-300">"TypeScript", "React", "Astro",</p>
                  <p class="pl-8 text-indigo-300">"Node.js", "PostgreSQL", "Tailwind"</p>
                  <p class="pl-4">],</p>
                  <p class="pl-4"><span class="text-slate-400">status:</span> <span class="text-emerald-400 font-semibold animate-pulse">"READY_TO_DEPLOY"</span></p>
                  <p>&#125;;</p>
                </div>

                <!-- Quick metrics badge row without IPK -->
                <div class="mt-6 pt-5 border-t border-slate-800 grid grid-cols-2 gap-3 text-center">
                  <div class="p-2.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition-colors">
                    <div class="text-lg font-bold text-indigo-400">Semester 5</div>
                    <div class="text-[10px] text-slate-400 font-mono uppercase">Status Akademik</div>
                  </div>
                  <div class="p-2.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/40 transition-colors">
                    <div class="text-lg font-bold text-emerald-400">10+ Proyek</div>
                    <div class="text-[10px] text-slate-400 font-mono uppercase">Karya & Praktikum</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BACK SIDE: Profile Photo & Academic Identification -->
            <div class="flip-card-back border-beam-box rounded-2xl p-[1px] w-full shadow-2xl">
              <div class="border-beam-inner spotlight-card glass-card p-6 sm:p-7 rounded-2xl border border-indigo-500/50 bg-slate-950/95 flex flex-col justify-between h-full">
                <!-- Header bar matching front side -->
                <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  </div>
                  <span class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    developer-identity.ts
                  </span>
                  <span class="text-[10px] font-mono text-indigo-400/90 flex items-center gap-1 bg-indigo-500/10 px-2 py-0.5 rounded-full border border-indigo-500/25">
                    <span>↺ Depan</span>
                  </span>
                </div>

                <!-- Center Content: Photo Slot + Identification -->
                <div class="py-2 flex flex-col items-center text-center">
                  <!-- Photo Slot with Glow & Fallback -->
                  <div class="relative group/avatar mb-3">
                    <div class="absolute -inset-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-cyan-500 rounded-2xl blur-md opacity-45 group-hover/avatar:opacity-85 transition duration-500"></div>
                    
                    <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl bg-slate-900 border-2 border-indigo-500/60 overflow-hidden flex flex-col items-center justify-center shadow-xl">
                      <!-- Photo Element (Automatically appears when public/avatar.jpg exists) -->
                      <img
                        src={profile.avatarUrl}
                        alt={profile.fullName}
                        class="w-full h-full object-cover"
                        onerror="this.style.display='none'; const ph = this.parentElement.querySelector('.avatar-placeholder'); if(ph) ph.classList.remove('hidden');"
                      />
                      <!-- Elegant Placeholder Slot for user's photo -->
                      <div class="avatar-placeholder hidden flex flex-col items-center justify-center p-2 text-center w-full h-full bg-gradient-to-b from-slate-900 to-slate-950">
                        <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300 mb-1 shadow-inner">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                        </div>
                        <span class="text-[10px] font-mono text-indigo-300 font-bold uppercase tracking-wider">Tempat Foto</span>
                        <span class="text-[8px] font-mono text-slate-400 mt-0.5">Letakkan foto di:</span>
                        <span class="text-[8px] font-mono text-emerald-400 font-semibold bg-slate-800 px-1 py-0.5 rounded mt-0.5">public/avatar.jpg</span>
                      </div>
                    </div>
                  </div>

                  <!-- Details with matching code/terminal style of front card -->
                  <div class="font-mono text-xs sm:text-sm space-y-1.5 w-full text-left bg-slate-900/60 p-3 sm:p-3.5 rounded-xl border border-slate-800/80">
                    <p class="text-slate-400 text-[11px]">// Identitas Terverifikasi</p>
                    <p>
                      <span class="text-slate-300 font-semibold">Nama:</span> <span class="text-emerald-300 font-bold">"{profile.fullName}"</span>
                    </p>
                    <p>
                      <span class="text-slate-300 font-semibold">Jurusan:</span> <span class="text-amber-300 font-medium">"D4 {profile.major}"</span>
                    </p>
                    <p>
                      <span class="text-slate-300 font-semibold">Kampus:</span> <span class="text-cyan-300 font-semibold">"{profile.university}"</span>
                    </p>
                  </div>
                </div>

                <!-- Bottom Status Row matching front card -->
                <div class="pt-3 border-t border-slate-800 grid grid-cols-2 gap-3 text-center font-mono">
                  <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800">
                    <div class="text-xs font-bold text-indigo-400">Aktif Semester 5</div>
                    <div class="text-[9px] text-slate-400 uppercase">Kandidat Magang</div>
                  </div>
                  <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800">
                    <div class="text-xs font-bold text-emerald-400">Kota Malang</div>
                    <div class="text-[9px] text-slate-400 uppercase">Lokasi Domisili</div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- Infinite Tech Stack Ticker (Marquee Banner) with Gradient Fade Edges -->
    <div class="mt-16 pt-8 border-t border-slate-900/80 relative overflow-hidden">
      <!-- Gradient Fade Edge Left & Right -->
      <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-slate-950 to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-slate-950 to-transparent z-10 pointer-events-none"></div>

      <div class="marquee-track flex items-center gap-6">
        {
          [...marqueeSkills, ...marqueeSkills, ...marqueeSkills].map((item, idx) => (
            <div class="flex items-center gap-4 flex-shrink-0 px-4 py-2 rounded-xl bg-slate-900/50 border border-slate-800/80 text-xs sm:text-sm font-mono text-slate-300 hover:text-indigo-400 hover:border-indigo-500/40 transition-colors">
              <span class="text-indigo-400 font-bold">✦</span>
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<!-- Client Script for Rotating Roles Typewriter -->
<script>
  const roles = [
    'Full-Stack Web Developer',
    'Frontend Engineer (React & Astro)',
    'UI/UX & Modern Web Architect',
    'Tech-Ready Internship Candidate',
  ];

  let roleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const roleEl = document.getElementById('typewriter-role');

  function typeRole() {
    if (!roleEl) return;
    const currentRole = roles[roleIndex];

    if (isDeleting) {
      charIndex--;
      roleEl.textContent = currentRole.substring(0, charIndex);
    } else {
      charIndex++;
      roleEl.textContent = currentRole.substring(0, charIndex);
    }

    let delay = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentRole.length) {
      delay = 2000; // Pause at end of text
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      roleIndex = (roleIndex + 1) % roles.length;
      delay = 400; // Pause before typing new text
    }

    setTimeout(typeRole, delay);
  }

  typeRole();

  // Kinetic Proximity Letter Zoom on Hero Headline
  const headline = document.getElementById('hero-headline');
  if (headline) {
    const chars = headline.querySelectorAll<HTMLElement>('.hero-char');
    const RADIUS = 85; // Proximity radius in pixels
    const MAX_SCALE = 1.45; // Max zoom magnification factor
    const MAX_LIFT = -6; // Upward translation in pixels

    headline.addEventListener('mousemove', (e) => {
      const mouseX = e.clientX;
      const mouseY = e.clientY;

      chars.forEach((charEl) => {
        const rect = charEl.getBoundingClientRect();
        const charCenterX = rect.left + rect.width / 2;
        const charCenterY = rect.top + rect.height / 2;

        const distance = Math.hypot(mouseX - charCenterX, mouseY - charCenterY);

        if (distance < RADIUS) {
          // Smooth cosine curve falloff for magnetic ripple effect
          const intensity = Math.cos((distance / RADIUS) * (Math.PI / 2));
          const scale = 1 + (MAX_SCALE - 1) * intensity;
          const translateY = MAX_LIFT * intensity;
          charEl.style.transform = `scale(${scale.toFixed(3)}) translateY(${translateY.toFixed(1)}px)`;
          charEl.style.zIndex = '20';
        } else {
          charEl.style.transform = 'scale(1) translateY(0px)';
          charEl.style.zIndex = '1';
        }
      });
    });

    headline.addEventListener('mouseleave', () => {
      chars.forEach((charEl) => {
        charEl.style.transform = 'scale(1) translateY(0px)';
        charEl.style.zIndex = '1';
      });
    });
  }

  // Mobile / Click flip toggle for internship candidate card
  const flipCard = document.getElementById('internship-flip-card');
  if (flipCard) {
    flipCard.addEventListener('click', () => {
      flipCard.classList.toggle('is-flipped');
    });
  }
</script>
