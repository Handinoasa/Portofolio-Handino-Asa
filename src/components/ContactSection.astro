---
import { profile } from '../data/portfolioData';
---

<section id="contact" class="py-16 sm:py-24 border-t border-slate-900 bg-slate-950/80 relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-indigo-600/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Recruiter Persuasion & Quick Direct Links (5 cols) -->
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
          Open For Internship Opportunities
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Mari Membangun Solusi Hebat Bersama
        </h2>
        
        <p class="mt-4 text-base text-slate-400 leading-relaxed">
          Saya siap berkontribusi penuh waktu atau magang program MBKM / Mandiri Semester 6 pada posisi <strong class="text-slate-200">{profile.targetRole}</strong>.
        </p>

        <!-- Direct Contact Info Badges -->
        <div class="mt-8 space-y-4">
          <!-- Email -->
          <a
            href={`mailto:${profile.email}`}
            class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-mono text-slate-400 uppercase">Email Resmi</span>
              <span class="text-sm font-semibold text-slate-200 group-hover:text-indigo-300 transition-colors">{profile.email}</span>
            </div>
          </a>

          <!-- WhatsApp / Phone -->
          <a
            href="https://wa.me/6282232347402?text=Halo%20Handino,%20saya%20tertarik%20dengan%20profil%20portofolio%20Anda."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-mono text-slate-400 uppercase">WhatsApp Cepat</span>
              <span class="text-sm font-semibold text-slate-200 group-hover:text-emerald-300 transition-colors">{profile.phone}</span>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
            <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center text-slate-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-mono text-slate-400 uppercase">Lokasi & Domisili</span>
              <span class="text-sm font-semibold text-slate-300">{profile.location} (Siap Relokasi/Remote)</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Contact Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/70 border border-slate-800/80 shadow-2xl">
          <h3 class="text-xl font-bold text-white mb-2">
            Kirim Undangan Wawancara / Pesan
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 mb-6">
            Pesan akan langsung diarahkan ke email pribadi saya dan dibalas dalam waktu kurang dari 24 jam kerja.
          </p>

          <form
            id="contact-form"
            class="space-y-4"
            onsubmit="event.preventDefault(); window.location.href = `mailto:${profile.email}?subject=Tawaran Magang dari ${encodeURIComponent(document.getElementById('sender-name').value || 'Recruiter')}&body=${encodeURIComponent(document.getElementById('sender-message').value + '\n\nDari: ' + document.getElementById('sender-email').value + ' (' + document.getElementById('sender-company').value + ')')}`;"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="sender-name" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
                  Nama Anda / Recruiter
                </label>
                <input
                  type="text"
                  id="sender-name"
                  required
                  placeholder="Contoh: HRD PT Teknologi Maju"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-800/70 border border-slate-700/60 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label for="sender-email" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
                  Email Perusahaan
                </label>
                <input
                  type="email"
                  id="sender-email"
                  required
                  placeholder="recruitment@company.com"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-800/70 border border-slate-700/60 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                />
              </div>
            </div>

            <div>
              <label for="sender-company" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
                Perusahaan / Organisasi & Posisi Magang
              </label>
              <input
                type="text"
                id="sender-company"
                placeholder="Contoh: Shopee / Tokopedia — Frontend Engineering Intern"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-800/70 border border-slate-700/60 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
              />
            </div>

            <div>
              <label for="sender-message" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
                Pesan Singkat / Jadwal Interview
              </label>
              <textarea
                id="sender-message"
                rows="4"
                required
                placeholder="Halo Handino, kami tertarik dengan portofolio dan proyek Anda. Kami ingin menjadwalkan sesi interview..."
                class="w-full px-4 py-2.5 rounded-xl bg-slate-800/70 border border-slate-700/60 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-indigo-500 to-purple-600 text-white hover:from-indigo-400 hover:to-purple-500 shadow-lg shadow-indigo-500/25 transition-all duration-200"
            >
              <span>Kirim Pesan Sekarang</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>
      </div>

    </div>

    <!-- Footer Copyright -->
    <div class="mt-16 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-slate-500 gap-4">
      <div>
        © 2026 {profile.fullName}. Built with Astro (Islands Architecture), React & Tailwind CSS.
      </div>
      <div class="flex items-center gap-4">
        <a href="#about" class="hover:text-slate-300 transition-colors">Kembali ke Atas ↑</a>
      </div>
    </div>

  </div>
</section>
