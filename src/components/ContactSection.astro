---
import { profile } from '../data/portfolioData';

const photoSlides = [
  {
    id: 1,
    src: '/photos/photo-1.jpg',
    tag: 'Dokumentasi Proyek Web',
    title: 'Full-Stack & Frontend Engineering',
    subtitle: 'Pengembangan web modern, Astro Islands, TypeScript & React',
    badge: 'Proyek DT & POS',
    filename: 'public/photos/photo-1.jpg',
  },
  {
    id: 2,
    src: '/photos/photo-2.jpg',
    tag: 'Aktivitas Akademik & Lab',
    title: 'Analisis Sistem & Rekayasa Database',
    subtitle: 'Pemodelan ERD, dokumen SRS, diagram alur, & asisten praktikum',
    badge: 'Akademik Polinema',
    filename: 'public/photos/photo-2.jpg',
  },
  {
    id: 3,
    src: '/photos/photo-3.jpg',
    tag: 'Organisasi & Kepanitiaan',
    title: 'Kolaborasi Tim & Manajemen Event',
    subtitle: 'Koordinasi lintas divisi, komunikasi profesional, & eksekusi program',
    badge: 'Organisasi Kampus',
    filename: 'public/photos/photo-3.jpg',
  },
  {
    id: 4,
    src: '/photos/photo-4.jpg',
    tag: 'Presentasi & Testing',
    title: 'QA Engineering & Solusi Industri',
    subtitle: 'Riset kebutuhan mitra, validasi fungsional, & testing sistem',
    badge: 'Mitra Industri',
    filename: 'public/photos/photo-4.jpg',
  },
];
---

<section id="contact" class="py-16 sm:py-24 border-t border-slate-900 bg-slate-950/80 relative overflow-hidden">
  <!-- Subtle ambient glow in background -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-indigo-600/10 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
    
    <!-- 2 Main Cards Grid: Left (Contact Info & Invite Button) | Right (Auto-Cycling Photo Showcase) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- CARD 1 (LEFT COLUMN - 6 or 7 cols): "Mari Membangun Solusi Hebat Bersama" Full Card -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="p-6 sm:p-8 lg:p-9 rounded-3xl bg-slate-900/80 border border-slate-800/90 shadow-2xl backdrop-blur-md flex flex-col justify-between h-full relative overflow-hidden group">
          <!-- Ambient gradient hover glow -->
          <div class="absolute -top-24 -left-24 w-60 h-60 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none group-hover:bg-indigo-500/25 transition duration-500"></div>

          <div>
            <!-- Status Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-5">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>Open For Internship Opportunities</span>
            </div>
            
            <!-- Main Title -->
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
              Mari Membangun Solusi Hebat Bersama
            </h2>
            
            <!-- Description -->
            <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
              Saya siap berkontribusi penuh waktu atau magang program MBKM / Mandiri Semester 6 pada posisi <strong class="text-white">{profile.targetRole}</strong>.
            </p>

            <!-- Direct Contact Info Items inside this Card -->
            <div class="mt-8 space-y-3.5">
              
              <!-- Email -->
              <a
                href={`mailto:${profile.email}`}
                class="flex items-center gap-4 p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80 hover:border-indigo-500/50 hover:bg-slate-900/90 transition-all duration-200 group/item"
              >
                <div class="w-11 h-11 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover/item:bg-indigo-600 group-hover/item:text-white transition-colors shrink-0 shadow-sm">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider">Email Resmi</span>
                  <span class="text-sm font-semibold text-slate-200 group-hover/item:text-indigo-300 transition-colors truncate block">{profile.email}</span>
                </div>
                <svg class="w-4 h-4 text-slate-500 group-hover/item:text-indigo-400 group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <!-- WhatsApp -->
              <a
                href="https://wa.me/6282232347402?text=Halo%20Handino,%20saya%20tertarik%20dengan%20profil%20portofolio%20Anda."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80 hover:border-emerald-500/50 hover:bg-slate-900/90 transition-all duration-200 group/item"
              >
                <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors shrink-0 shadow-sm">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider">WhatsApp Cepat</span>
                  <span class="text-sm font-semibold text-slate-200 group-hover/item:text-emerald-300 transition-colors truncate block">{profile.phone}</span>
                </div>
                <svg class="w-4 h-4 text-slate-500 group-hover/item:text-emerald-400 group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <!-- Alamat & Domisili -->
              <div class="flex items-center gap-4 p-4 rounded-2xl bg-slate-950/70 border border-slate-800/80">
                <div class="w-11 h-11 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 shrink-0 shadow-sm">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="block text-[11px] font-mono text-slate-400 uppercase tracking-wider">Alamat & Domisili</span>
                  <span class="text-sm font-semibold text-slate-200">{profile.location} <span class="text-xs text-indigo-400 font-mono font-normal">(Siap Relokasi / Remote)</span></span>
                </div>
              </div>

            </div>
          </div>

          <!-- Action Button: Kirim Undangan Wawancara (Opens clean recruiter form modal) -->
          <div class="mt-8 pt-6 border-t border-slate-800/90">
            <button
              id="open-invite-modal-btn"
              type="button"
              class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl text-sm font-bold bg-gradient-to-r from-indigo-500 via-indigo-600 to-purple-600 text-white hover:from-indigo-400 hover:to-purple-500 shadow-xl shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 active:scale-95 transition-all duration-200 cursor-pointer"
            >
              <svg class="w-5 h-5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Kirim Undangan Wawancara</span>
              <svg class="w-4 h-4 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- CARD 2 (RIGHT COLUMN - 5 cols): Auto-Cycling Photo Gallery Card -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="border-beam-box rounded-3xl p-[1px] shadow-2xl h-full flex flex-col">
          <div class="border-beam-inner glass-card p-6 sm:p-7 rounded-3xl border border-slate-700/60 bg-slate-950/90 flex flex-col justify-between h-full relative overflow-hidden">
            
            <!-- Header bar matching code terminal aesthetic -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-800 shrink-0">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              </div>
              <span class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                identity-gallery.ts
              </span>
              <div class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-[10px] font-mono">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>AUTO-SLIDE</span>
              </div>
            </div>

            <!-- Slideshow Screen Container: Automatically cycles without user scrolling -->
            <div id="contact-carousel" class="my-5 relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/90 min-h-[340px] sm:min-h-[380px] flex-1 flex flex-col justify-end group/carousel">
              
              <!-- Photo Slides Container -->
              {
                photoSlides.map((slide, idx) => (
                  <div
                    class={`contact-slide absolute inset-0 transition-all duration-700 ease-in-out flex flex-col justify-between ${
                      idx === 0 ? 'opacity-100 z-10 scale-100' : 'opacity-0 z-0 scale-95 pointer-events-none'
                    }`}
                    data-slide-index={idx}
                  >
                    <!-- Real Photo (will render automatically when photo-X.jpg is placed in public/photos/) -->
                    <img
                      src={slide.src}
                      alt={slide.title}
                      class="w-full h-full object-cover absolute inset-0"
                      onerror="this.style.display='none'; const ph = this.parentElement.querySelector('.slide-placeholder'); if(ph) ph.classList.remove('hidden');"
                    />

                    <!-- Elegant Placeholder Slot (Displays if photo file is not yet placed) -->
                    <div class="slide-placeholder hidden w-full h-full absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
                      <!-- Ambient glow inside placeholder -->
                      <div class="w-24 h-24 rounded-full bg-indigo-500/15 blur-2xl absolute pointer-events-none"></div>

                      <!-- Icon circle -->
                      <div class="relative w-16 h-16 rounded-2xl bg-slate-800/90 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-3 shadow-xl">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>

                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 mb-2">
                        {slide.tag}
                      </span>

                      <h4 class="text-base font-bold text-white tracking-tight">
                        {slide.title}
                      </h4>
                      <p class="text-xs text-slate-400 mt-1 max-w-xs leading-relaxed">
                        {slide.subtitle}
                      </p>

                      <!-- File placement indicator -->
                      <div class="mt-4 px-3 py-1.5 rounded-lg bg-slate-900/90 border border-dashed border-slate-700/80 text-[10px] font-mono text-slate-400">
                        <span>Slot Foto Siap: </span>
                        <code class="text-emerald-400 font-semibold">{slide.filename}</code>
                      </div>
                    </div>

                    <!-- Slide Caption Overlay (Always shown over photo for context) -->
                    <div class="relative z-10 mt-auto p-4 sm:p-5 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent">
                      <div class="flex items-center justify-between gap-2 mb-1">
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-semibold">
                          {slide.badge}
                        </span>
                        <span class="text-[10px] font-mono text-slate-400">
                          {slide.tag}
                        </span>
                      </div>
                      <h4 class="text-sm sm:text-base font-bold text-white drop-shadow-md">
                        {slide.title}
                      </h4>
                      <p class="text-xs text-slate-300 line-clamp-1 drop-shadow mt-0.5">
                        {slide.subtitle}
                      </p>
                    </div>
                  </div>
                ))
              }

              <!-- Subtle Arrow buttons to manual review -->
              <button
                id="carousel-prev-btn"
                type="button"
                aria-label="Previous photo"
                class="absolute left-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-slate-950/70 border border-slate-700/80 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-opacity hover:bg-indigo-600 hover:border-indigo-500"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                id="carousel-next-btn"
                type="button"
                aria-label="Next photo"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-slate-950/70 border border-slate-700/80 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-opacity hover:bg-indigo-600 hover:border-indigo-500"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>

            <!-- Bottom Carousel Controls & Indicators -->
            <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-mono shrink-0">
              <!-- Indicators Dots -->
              <div class="flex items-center gap-1.5" id="carousel-indicators">
                {
                  photoSlides.map((_, idx) => (
                    <button
                      type="button"
                      aria-label={`Go to slide ${idx + 1}`}
                      class={`carousel-dot h-2 rounded-full transition-all duration-300 ${
                        idx === 0 ? 'w-6 bg-indigo-500' : 'w-2 bg-slate-700 hover:bg-slate-500'
                      }`}
                      data-indicator-index={idx}
                    ></button>
                  ))
                }
              </div>

              <!-- Counter -->
              <span id="carousel-counter" class="text-slate-400">
                01 / 04
              </span>
            </div>

          </div>
        </div>
      </div>

    </div>

    <!-- Footer Copyright -->
    <div class="mt-16 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-slate-500 gap-4">
      <div>
        © 2026 {profile.fullName}. Built with Astro (Islands Architecture), React & Tailwind CSS.
      </div>
      <div class="flex items-center gap-4">
        <a href="#about" class="hover:text-slate-300 transition-colors">Kembali ke Atas ↑</a>
      </div>
    </div>

  </div>
</section>

<!-- Recruiter Invitation Form Modal -->
<div
  id="invite-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
>
  <div class="relative w-full max-w-lg p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-700/80 shadow-2xl scale-95 transition-transform duration-300 modal-card">
    
    <!-- Modal Close Button -->
    <button
      id="close-invite-modal-btn"
      type="button"
      aria-label="Tutup form"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 flex items-center justify-center transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-5">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-2">
        Undangan Wawancara / Penawaran Magang
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-white">
        Kirim Undangan Wawancara
      </h3>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Pesan akan langsung diteruskan ke email pribadi <span class="text-slate-200 font-semibold">{profile.fullName}</span>.
      </p>
    </div>

    <form
      id="modal-contact-form"
      class="space-y-4"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="modal-sender-name" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
            Nama Anda / Recruiter *
          </label>
          <input
            type="text"
            id="modal-sender-name"
            required
            placeholder="Contoh: Bpk/Ibu HRD"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label for="modal-sender-email" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
            Email Perusahaan *
          </label>
          <input
            type="email"
            id="modal-sender-email"
            required
            placeholder="recruitment@company.com"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div>
        <label for="modal-sender-company" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
          Perusahaan & Posisi yang Ditawarkan *
        </label>
        <input
          type="text"
          id="modal-sender-company"
          required
          placeholder="Contoh: PT Teknologi Bangsa — Frontend Engineering Intern"
          class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <div>
        <label for="modal-sender-message" class="block text-xs font-mono text-slate-300 mb-1.5 uppercase">
          Jadwal Wawancara / Pesan Tambahan *
        </label>
        <textarea
          id="modal-sender-message"
          rows="3"
          required
          placeholder="Halo Handino, kami tertarik dengan kualifikasi Anda dan ingin mengundang Anda ke tahap interview pada..."
          class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/80 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
        ></textarea>
      </div>

      <div class="pt-2 flex items-center justify-end gap-3">
        <button
          type="button"
          id="cancel-modal-btn"
          class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white transition-colors"
        >
          Batal
        </button>
        <button
          type="submit"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-gradient-to-r from-indigo-500 to-purple-600 text-white hover:from-indigo-400 hover:to-purple-500 shadow-md shadow-indigo-500/25 transition-all"
        >
          <span>Kirim Undangan Sekarang</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Client-side script for Auto-Cycling Slideshow & Modal Controller -->
<script>
  // ─── AUTO-CYCLING PHOTO GALLERY CONTROLLER ───
  let currentSlide = 0;
  const slides = document.querySelectorAll<HTMLElement>('.contact-slide');
  const dots = document.querySelectorAll<HTMLElement>('.carousel-dot');
  const counter = document.getElementById('carousel-counter');
  const totalSlides = slides.length;
  let cycleTimer: ReturnType<typeof setInterval> | null = null;

  function showSlide(index: number) {
    if (totalSlides === 0) return;
    currentSlide = (index + totalSlides) % totalSlides;

    slides.forEach((slide, idx) => {
      if (idx === currentSlide) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'scale-95', 'z-0');
        slide.classList.add('opacity-100', 'scale-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'scale-100', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'scale-95', 'z-0');
      }
    });

    dots.forEach((dot, idx) => {
      if (idx === currentSlide) {
        dot.className = 'carousel-dot h-2 rounded-full transition-all duration-300 w-6 bg-indigo-500';
      } else {
        dot.className = 'carousel-dot h-2 rounded-full transition-all duration-300 w-2 bg-slate-700 hover:bg-slate-500';
      }
    });

    if (counter) {
      counter.textContent = `0${currentSlide + 1} / 0${totalSlides}`;
    }
  }

  function startAutoCycle() {
    stopAutoCycle();
    cycleTimer = setInterval(() => {
      showSlide(currentSlide + 1);
    }, 3500); // Cycles every 3.5 seconds smoothly
  }

  function stopAutoCycle() {
    if (cycleTimer) {
      clearInterval(cycleTimer);
      cycleTimer = null;
    }
  }

  // Next / Prev button event listeners
  document.getElementById('carousel-next-btn')?.addEventListener('click', () => {
    showSlide(currentSlide + 1);
    startAutoCycle();
  });

  document.getElementById('carousel-prev-btn')?.addEventListener('click', () => {
    showSlide(currentSlide - 1);
    startAutoCycle();
  });

  // Dots click
  dots.forEach((dot, idx) => {
    dot.addEventListener('click', () => {
      showSlide(idx);
      startAutoCycle();
    });
  });

  // Pause on hover
  const carouselEl = document.getElementById('contact-carousel');
  if (carouselEl) {
    carouselEl.addEventListener('mouseenter', stopAutoCycle);
    carouselEl.addEventListener('mouseleave', startAutoCycle);
  }

  // Initialize auto-cycle
  startAutoCycle();

  // ─── RECRUITER INVITATION MODAL CONTROLLER ───
  const openModalBtn = document.getElementById('open-invite-modal-btn');
  const closeModalBtn = document.getElementById('close-invite-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const modal = document.getElementById('invite-modal');
  const modalForm = document.getElementById('modal-contact-form');

  function openModal() {
    if (!modal) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
    const card = modal.querySelector('.modal-card');
    if (card) {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
    const card = modal.querySelector('.modal-card');
    if (card) {
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
    }
    document.body.style.overflow = '';
  }

  openModalBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Close on ESC key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
      closeModal();
    }
  });

  // Form submit handler
  modalForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nameEl = document.getElementById('modal-sender-name') as HTMLInputElement | null;
    const emailEl = document.getElementById('modal-sender-email') as HTMLInputElement | null;
    const companyEl = document.getElementById('modal-sender-company') as HTMLInputElement | null;
    const msgEl = document.getElementById('modal-sender-message') as HTMLTextAreaElement | null;

    const senderName = nameEl?.value || 'Recruiter';
    const senderEmail = emailEl?.value || '';
    const company = companyEl?.value || '';
    const message = msgEl?.value || '';

    const subject = encodeURIComponent(`Undangan Wawancara Magang - ${company} (${senderName})`);
    const body = encodeURIComponent(
      `Halo Handino Asa Galih Romadhon,\n\n${message}\n\nSalam,\n${senderName}\nPerusahaan: ${company}\nEmail: ${senderEmail}`
    );

    window.location.href = `mailto:hasagalihr@gmail.com?subject=${subject}&body=${body}`;
    closeModal();
  });
</script>
