---
import { experiences } from '../data/portfolioData';

const typeLabels: Record<string, { label: string; color: string }> = {
  organization: { label: 'Organisasi Kampus', color: 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30' },
  committee: { label: 'Kepanitiaan Event', color: 'bg-purple-500/10 text-purple-300 border-purple-500/30' },
  lab: { label: 'Asisten Laboratorium', color: 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30' },
  certification: { label: 'Sertifikasi Industri', color: 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30' },
  achievement: { label: 'Pencapaian & Prestasi', color: 'bg-amber-500/10 text-amber-300 border-amber-500/30' },
};
---

<section id="experience" class="py-16 sm:py-24 border-t border-slate-900 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto reveal-init">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Track Record & Credentials
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Pengalaman Organisasi, Lab & Sertifikasi
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400 leading-relaxed">
        Aktivitas kepemimpinan tim, kontribusi akademik sebagai asisten lab, serta kredensial sertifikasi teknologi yang diakui industri.
      </p>
    </div>

    <!-- Experience Cards Grid (4 Cards) -->
    <div class="mt-12 sm:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        experiences.map((exp, index) => {
          const typeMeta = typeLabels[exp.type] || typeLabels.organization;
          const isEmpty = !exp.title || exp.title.trim() === '';

          if (isEmpty) {
            return (
              <div class="interactive-card reveal-init relative p-8 rounded-2xl bg-slate-900/30 border border-dashed border-slate-800/80 hover:border-indigo-500/50 transition-all duration-300 flex flex-col items-center justify-center text-center min-h-[200px] group cursor-pointer">
                <div class="w-10 h-10 rounded-xl bg-slate-800/60 border border-slate-700/50 flex items-center justify-center text-slate-500 group-hover:text-indigo-400 group-hover:border-indigo-500/40 transition-colors mb-3">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                </div>
                <h3 class="text-sm font-bold text-slate-400 group-hover:text-slate-200 transition-colors">
                  Card Pengalaman 0{index + 1}
                </h3>
                <p class="text-xs font-mono text-slate-500 group-hover:text-indigo-400 transition-colors mt-1">
                  [Card Kosong — Siap diisi di portfolioData.ts]
                </p>
              </div>
            );
          }

          return (
            <div class="relative p-6 sm:p-7 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-slate-700/80 transition-all duration-300 flex flex-col justify-between">
              <div>
                <!-- Type Badge & Period -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono border ${typeMeta.color}`}>
                    {typeMeta.label}
                  </span>
                  <span class="text-xs font-mono text-slate-400">
                    {exp.period}
                  </span>
                </div>

                <!-- Title & Organization -->
                <h3 class="text-lg sm:text-xl font-bold text-white mt-1">
                  {exp.title}
                </h3>
                <h4 class="text-sm font-semibold text-indigo-400 mt-0.5 mb-3">
                  {exp.organization}
                </h4>

                <!-- Description -->
                <p class="text-sm text-slate-300 leading-relaxed">
                  {exp.description}
                </p>
              </div>

              <!-- Tags and link -->
              <div class="mt-6 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap gap-1.5">
                  {exp.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700/50">
                      {tag}
                    </span>
                  ))}
                </div>

                {exp.link && (
                  <a
                    href={exp.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-mono text-indigo-400 hover:text-indigo-300 hover:underline"
                  >
                    <span>Verifikasi Kredensial</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
