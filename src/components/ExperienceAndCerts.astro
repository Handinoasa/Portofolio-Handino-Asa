---
import ExperienceCards from './ExperienceCards';
---

<section id="experience" class="py-14 sm:py-20 border-t border-slate-900 bg-slate-950 overflow-hidden">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Track Record & Credentials
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Pengalaman Organisasi, Lab & Sertifikasi
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400 leading-relaxed">
        Aktivitas kepemimpinan tim, kontribusi akademik sebagai asisten lab, serta kredensial sertifikasi teknologi yang diakui industri.
      </p>
    </div>

    <!-- Experience Cards Grid (4 Cards: 1 & 3 from Top, 2 & 4 from Bottom) -->
    <ExperienceCards client:visible />

  </div>
</section>

