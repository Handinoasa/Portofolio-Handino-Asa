---
import { skills, type SkillCategory } from '../data/portfolioData';

const categories: SkillCategory[] = [
  'Languages',
  'Frontend & Mobile',
  'Backend, Databases & Cloud',
  'Tools, DevOps & Workflow',
];

const categoryIcons: Record<SkillCategory, string> = {
  Languages: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  'Frontend & Mobile': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  'Backend, Databases & Cloud': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>`,
  'Tools, DevOps & Workflow': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
};

const levelBadgeStyles = {
  Core: 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30',
  Intermediate: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
  Learning: 'bg-slate-700/30 text-slate-400 border-slate-700/50',
};
---

<section id="skills" class="py-16 sm:py-24 border-t border-slate-900 bg-slate-950/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Practical Competencies
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Skill Matrix
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400 leading-relaxed">
        Kontekstual berdasarkan implementasi nyata di proyek akademik, organisasi, serta practical engineering.
      </p>

      <!-- Legend -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs font-mono">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          <span class="text-slate-300">Core (Sering dipakai di multi-proyek)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span class="text-slate-300">Intermediate (Paham konsep & teruji di perkuliahan)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
          <span class="text-slate-400">Learning (Eksplorasi aktif Semester 5)</span>
        </div>
      </div>
    </div>

    <!-- 4 Category Groups Grid -->
    <div class="mt-12 sm:mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        categories.map((cat) => {
          const catSkills = skills.filter((s) => s.category === cat);
          return (
            <div class="interactive-card spotlight-card reveal-init p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/50 transition-all duration-300">
              <!-- Group Header -->
              <div class="flex items-center gap-3 pb-5 border-b border-slate-800/80 mb-5">
                <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-indigo-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[cat]} />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white">{cat}</h3>
                  <span class="text-xs font-mono text-slate-400">{catSkills.length} tools & technologies</span>
                </div>
              </div>

              <!-- Skills List in Group -->
              <div class="space-y-3">
                {catSkills.map((skill) => (
                  <div class="p-3 rounded-xl bg-slate-800/40 border border-slate-700/30 flex items-center justify-between gap-3 hover:bg-slate-800/80 hover:border-slate-600/60 hover:translate-x-1 transition-all duration-200">
                    <div class="flex items-center gap-2.5">
                      <span class="text-sm font-semibold text-slate-100">{skill.name}</span>
                    </div>
                    <div class="flex items-center gap-2 text-right">
                      <span class="hidden sm:inline text-xs text-slate-400 font-mono">
                        {skill.context}
                      </span>
                      <span class={`px-2 py-0.5 rounded text-[11px] font-mono border ${levelBadgeStyles[skill.level]}`}>
                        {skill.level}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
