---
import SkillsMatrixCards from './SkillsMatrixCards';
---

<section id="skills" class="py-14 sm:py-20 border-t border-slate-900 bg-slate-950/70 overflow-hidden">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Practical Competencies
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Skill Matrix
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-400 leading-relaxed">
        Kontekstual berdasarkan implementasi nyata di proyek akademik, organisasi, serta practical engineering.
      </p>

      <!-- Legend -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3 text-xs font-mono">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          <span class="text-slate-300">Core</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span class="text-slate-300">Intermediate</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-500"></span>
          <span class="text-slate-400">Learning</span>
        </div>
      </div>
    </div>

    <!-- 4 Category Groups Grid: 1 Single Row on Desktop (Alternating Top/Bottom Animations) -->
    <SkillsMatrixCards client:visible />

  </div>
</section>
