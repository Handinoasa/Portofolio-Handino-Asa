---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhyHireMe from '../components/WhyHireMe.astro';
import SemesterTimeline from '../components/SemesterTimeline';
import ProjectsShowcase from '../components/ProjectsShowcase';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ExperienceAndCerts from '../components/ExperienceAndCerts.astro';
import ContactSection from '../components/ContactSection.astro';
import { profile } from '../data/portfolioData';

const pageTitle = `${profile.fullName} — Portofolio Magang Semester 6 (Teknik Informatika)`;
---

<MainLayout title={pageTitle}>
  <!-- Sticky Responsive Navbar -->
  <Navbar />

  <!-- Main Content Flow -->
  <main class="relative z-10 flex flex-col">
    <!-- Hero Section -->
    <Hero />

    <!-- Recruiter Bento Grid: Why Hire Me -->
    <WhyHireMe />

    <!-- React Island 1: Semester 1-5 Roadmap & Coursework Exploration -->
    <SemesterTimeline client:visible />

    <!-- React Island 2: Interactive Projects Showcase + STAR Method Case Studies -->
    <ProjectsShowcase client:load />

    <!-- Technical Skills Matrix -->
    <SkillsMatrix />

    <!-- Leadership, Lab Assistant & Certifications -->
    <ExperienceAndCerts />

    <!-- Contact & Interview Scheduler -->
    <ContactSection />
  </main>
</MainLayout>
